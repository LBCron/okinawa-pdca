---
// 基本計画の本文を全部載せた1つのページ（形は components/Honbun.astro）
import Base from '../../../layouts/Base.astro';
import ExtLink from '../../../components/ExtLink.astro';
import Honbun from '../../../components/Honbun.astro';
import { HONBUN_PLANS, VISION_HREF, honbunRows } from '../../../lib/honbun.ts';
import { honbunMeta } from '../../../lib/describe.ts';
import { planSourceLink } from '../../../lib/plans.ts';

const info = HONBUN_PLANS.kihon;
const meta = honbunMeta('kihon');
const src = planSourceLink('kihon', honbunRows('kihon')[0].source);
---
<Base title={meta.title} description={meta.description} ogType="article">
  <Honbun plan="kihon">
    <Fragment slot="lead">
      <p class="lead">
        沖縄県が{info.published}に策定した、{info.period}の沖縄振興の計画です。沖縄県PDCAの施策と主な取組は、この計画の基本施策（第4章）を<a href={VISION_HREF}>実施計画</a>で具体化したものです。
        県の PDF の本文を全部このページに載せているので、ブラウザのページ内検索（パソコンは Ctrl+F・⌘F）で全文から探せます。基本施策と施策の見出しからは、このサイトのその進み具合のページへ移れます。
      </p>
      <p class="small secondary">{src && <ExtLink href={src.href}>{src.label}（PDF）</ExtLink>}。「*」の付いた言葉は、県の資料編に用語の説明があります。</p>
    </Fragment>
    <p slot="about">
      {src && <><ExtLink href={src.href}>{src.label}</ExtLink>（沖縄県、{info.published}）の PDF の文字を読み取ったものです。</>}
      段落の中の改行は画面の幅に合わせ、ページの区切りは段落の頭に印字のページで示しています。ふりがなと図は省いています（図は PDF で見てください）。
      「*」の付いた言葉は、県の資料編に用語の説明があります。
    </p>
  </Honbun>
</Base>
