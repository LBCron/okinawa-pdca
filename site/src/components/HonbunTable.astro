---
// 実施計画の本文の表1つ（components/Honbun.astro）。PDF の表の形ではなく、このサイトのほかのページと同じ見せ方にする（組み直しは lib/jisshi.ts）:
//  - 成果指標・主要指標: 成果指標のカードと同じ「基準値 → 目標値」の1行（RouteVals）。全国の値と【参考値】は下に小さく添える
//  - 主な取組: 施策のページの取組の一覧と同じ、細い線で区切った行の箱（.row-list）。「○…」のまとまりは行の箱の中の小見出し。
//    行は名前（取組のページへのリンク）・所管・実施主体・活動・活動指標と、取組のページの活動指標と同じ年度の表（.year-table）の計画値。
//    活動や活動指標が年度で変わるものは、表の行にして年度の列をまたがせる
//  - 協働の主体: 主体ごとの役割の箇条。第4章の主な事業・取組: 行の一覧
// 形が読めない表（第1章の期間・構成の表など）は、PDF と同じ表のまま出す
import RouteVals from './RouteVals.astro';
import { nameKey, torikumiPage } from '../lib/data.ts';
import { parenSplit } from '../lib/text.ts';
import { planJigyo, planKyodo, planSeika, planShuyou, planTorikumi, type PlanSeika, type PlanVal } from '../lib/jisshi.ts';
import type { HonbunTable } from '../lib/types.ts';

interface Props { t: HonbunTable; targets?: PlanVal[] }
const { t, targets = [] } = Astro.props;

const seika = t.table === 'seika' ? planSeika(t, targets) : null;
const shuyou = t.table === 'shuyou' ? planShuyou(t) : null;
const kyodo = t.table === 'kyodo' ? planKyodo(t) : null;
const torikumi = t.table === 'torikumi' ? planTorikumi(t) : null;
const jigyo = t.table === 'other' ? planJigyo(t) : null;
const indicators: PlanSeika[] | null = seika ? [seika] : shuyou;
// 目標値（計画の期間の終わりの値）を太くする。成果指標は表の目標値、主要指標はいちばん近い年度の目標値
const goalIndex = (s: PlanSeika) => s.route.findIndex((v) => v.label.includes('目標値'));
const toriHref = (key: string) => (t.shisaku ? torikumiPage(t.shisaku, nameKey(key)) : null);
---
{indicators ? (
  <div class="pv">
    {indicators.map((s) => (
      <div class="pv-one inset">
        <div class="pv-name">{t.table === 'seika' ? '成果指標' : '主要指標'}：{s.name}</div>
        <RouteVals vals={s.route.map((v, i) => ({ label: v.label, v: v.v, y: v.y || null, now: i === goalIndex(s) }))} />
        {s.route.filter((v) => v.note).map((v) => <p class="pv-sub small secondary">{v.label}の{v.note}</p>)}
        {s.national && <p class="pv-sub small secondary">{s.national.label}: {s.national.v}{s.national.y && `（${s.national.y}）`}{s.national.note && ` ${s.national.note}`}</p>}
      </div>
    ))}
  </div>
)
: kyodo ? (
  <dl class="ky">
    {kyodo.map((k) => (
      <div class="ky-row">
        <dt>{k.who}</dt>
        <dd><ul>{k.roles.map((r) => <li>{r}</li>)}</ul></dd>
      </div>
    ))}
  </dl>
)
: torikumi ? (
  <ul class="row-list pt">
    {torikumi.rows.map((r) => r.kind === 'group' ? (
      <li class="pt-grp">{r.text}</li>
    ) : (() => {
      const href = toriHref(r.key);
      const actSplit = r.activity.length > 1;
      const indSplit = r.indicator.length > 1;
      return (
        <li class="pt-row">
          <div class="pt-name">
            {href ? <a class="name-link" href={href}>{r.name}</a> : <span class="pt-n">{r.name}</span>}
            {r.repost && <span class="pt-re small secondary">再掲</span>}
          </div>
          <div class="pt-meta small secondary">{r.dept && <span>{r.dept}</span>}<span>実施主体: {r.actors.join('・')}</span></div>
          {!actSplit && <p class="pt-line"><span class="pt-l">活動</span>{r.activity[0].text}</p>}
          {!indSplit && <p class="pt-line"><span class="pt-l">活動指標</span>{r.indicator[0].text}</p>}
          <div class="table-wrap">
            <table class="year-table pt-t">
              <caption class="sr-only">{r.name}の年度ごとの計画</caption>
              <thead><tr><td></td>{torikumi.years.map((y) => <th scope="col" class="num">{y}</th>)}</tr></thead>
              <tbody>
                {actSplit && <tr><th scope="row">活動</th>{r.activity.map((s) => <td class="text" colspan={s.span}>{s.text}</td>)}</tr>}
                {indSplit && <tr><th scope="row">活動指標</th>{r.indicator.map((s) => <td class="text" colspan={s.span}>{s.text}</td>)}</tr>}
                <tr><th scope="row">計画</th>{r.values.map((v) => {
                  if (v.span > 1) return <td class="text" colspan={v.span}>{v.text}</td>;
                  const [a, b] = parenSplit(v.text || '—');
                  return <td class="num">{a}{b && <span class="paren">{b}</span>}</td>;
                })}</tr>
              </tbody>
            </table>
          </div>
        </li>
      );
    })())}
  </ul>
)
: jigyo ? (
  <ul class="row-list pt">
    {jigyo.map((j) => (
      <li class="pt-row">
        <div class="pt-name"><span class="pt-no small secondary">{j.no}</span><span class="pt-n">{j.name}</span></div>
        <div class="pt-meta small secondary"><span>実施主体: {j.actors.join('・')}</span><span>事業期間: {j.period}</span></div>
        <p class="pt-line">{j.summary}</p>
      </li>
    ))}
  </ul>
)
: (
  <div class="table-wrap hb-tw">
    <table class="hb-t">
      {t.caption && <caption>{t.caption}</caption>}
      {t.head.length > 0 && <thead>{t.head.map((r) => <tr>{r.map((c) => <th scope="col" colspan={c.cs} rowspan={c.rs}>{c.text}</th>)}</tr>)}</thead>}
      <tbody>{t.body.map((r) => <tr>{r.map((c) => <td colspan={c.cs} rowspan={c.rs}>{c.text}</td>)}</tr>)}</tbody>
    </table>
  </div>
)}

<style is:global>
  /* 要素ごとに data-astro-cid を付けないよう（本文の表は数千あり、HTML が大きくなる）、本文（.hb-body）の中だけに効く global の CSS にする */
  /* 成果指標・主要指標（成果指標のカードの値の1行と同じ）。本文の中の箱なので、線も影も無い地の色だけ（.inset） */
  .hb-body .pv { display: grid; gap: 8px; margin: 0.6em 0 1em; clear: both; }
  .hb-body .pv-one { padding: 10px 14px 12px; }
  .hb-body .pv-name { font-weight: 700; color: var(--ink); white-space: pre-line; }
  .hb-body .pv-sub { margin: 4px 0 0; }
  /* 協働の主体。左に主体、右に役割の箇条（スマホの幅では上下） */
  .hb-body .ky { clear: both; margin: 0.6em 0 1em; display: grid; gap: 1.5px; background: var(--grid); border-block: 1.5px solid var(--grid); }
  .hb-body .ky-row { display: grid; grid-template-columns: 11em minmax(0, 1fr); gap: 0 16px; background: var(--paper); padding: 8px 4px; }
  .hb-body .ky dt { font-weight: 700; }
  .hb-body .ky dd { margin: 0; }
  .hb-body .ky ul { margin: 0; padding-left: 1.1em; }
  /* 主な取組・主な事業（施策のページの取組の一覧と同じ行の箱）。本文の中を目次から跳ぶので、行を画面の外でも描く（content-visibility は使わない） */
  .hb-body .pt { margin: 0.6em 0 1.2em; clear: both; }
  .hb-body .pt > li { content-visibility: visible; }
  .hb-body .pt-grp { font-family: var(--font-display); font-weight: 700; font-size: 0.9375rem; background: var(--bg); padding: 8px 16px; }
  .hb-body .pt-row { display: grid; gap: 4px; }
  .hb-body .pt-name { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .hb-body .pt-n { font-weight: 700; }
  .hb-body .pt-no { font-family: var(--font-num); }
  .hb-body .pt-meta { display: flex; flex-wrap: wrap; gap: 0 14px; }
  .hb-body .pt-line { margin: 0; font-size: 0.9375rem; }
  .hb-body .pt-l { display: inline-block; min-width: 4.5em; margin-right: 8px; font-size: 0.75rem; font-weight: 700; color: var(--ink-2); }
  .hb-body .pt-t { font-size: 0.875rem; margin-top: 2px; }
  .hb-body .pt-t th[scope="row"] { width: 5em; }
  .hb-body .pt-t td.text { white-space: normal; min-width: 0; }
  /* 形の読めない表は PDF と同じく、セルの全部に罫線を引き、セルの中の改行は印字のまま出す */
  .hb-body .hb-tw { clear: both; margin: 0.6em 0 1em; }
  .hb-body .hb-t { font-size: 0.8125rem; line-height: 1.6; background: var(--paper); }
  .hb-body .hb-t :is(th, td) { border: 1.5px solid var(--grid); padding: 6px 8px; white-space: pre-line; }
  .hb-body .hb-t thead th { background: var(--bg); color: var(--ink); text-align: center; vertical-align: middle; }
  .hb-body .hb-t caption { font-weight: 700; color: var(--ink); white-space: pre-line; }
  @media (max-width: 640px) {
    .hb-body .ky-row { grid-template-columns: minmax(0, 1fr); }
  }
</style>
