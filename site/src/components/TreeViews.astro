---
// 計画の木の見せ方の切り替え（目次 /mokuji/ と樹形図 /mokuji/jukeizu/）。同じ木を、行の並びと枝分かれの図のどちらで見るかを選ぶ。
// いまのページは aria-current="page" で伝え、押せない札にする
interface Props {
  current: 'mokuji' | 'jukeizu';
}
const { current } = Astro.props;
const VIEWS = [
  { key: 'mokuji', href: '/mokuji/', label: '目次' },
  { key: 'jukeizu', href: '/mokuji/jukeizu/', label: '樹形図' },
] as const;
---
<nav class="tree-views" aria-label="計画の見せ方">
  {VIEWS.map((v) => (v.key === current ? <span class="tag tv-now" aria-current="page">{v.label}</span> : <a class="tag" href={v.href}>{v.label}</a>))}
</nav>

<style>
  .tree-views { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; }
  .tv-now { background: var(--sky); box-shadow: 2px 2px 0 var(--shadow); }
  .tv-now::before { content: '✓'; content: '✓' / ''; }
</style>
