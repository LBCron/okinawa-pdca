---
// 基本計画の本文のページ（/kihonkeikaku/ と章・将来像のページ）。左に全体の目次、右に本文を置く（法令の全文のページのような形）。
// 目次は、どのページにも章と第4章の将来像を並べ、いまのページの所だけ中の見出しまで開く（全部の見出しを並べると長く、重くなるため）。
// スマホの幅では目次を本文の上の貼り付いた「目次」のボタンから開く（scripts/honbun.ts。スクリプトが動かないときは、本文の前にそのまま出す）。
// いま読んでいる見出しは、目次のリンクに印を付け、スマホの貼り付いた行にも名前を出す（scripts/honbun.ts）
import Base from '../layouts/Base.astro';
import ExtLink from './ExtLink.astro';
import { KIHON_KEIKAKU, honbunParts, honbunAnchor, headingTag, headingText, splitNotes, type HonbunPart } from '../lib/honbun.ts';
import { honbunMeta } from '../lib/describe.ts';
import { planSourceLink } from '../lib/plans.ts';
import type { HonbunHeading, KihonHonbunRow } from '../lib/types.ts';

interface Props { part: HonbunPart }
const { part } = Astro.props;
const parts = honbunParts();
const top = part.slug === '';
const at = parts.indexOf(part);
const prev = parts[at - 1];
const next = parts[at + 1];
const inner = [...part.lead, ...part.blocks];
const headings = inner.filter((b): b is HonbunHeading => b.kind === 'h');
const meta = honbunMeta({
  head: headingText(part.head),
  chapter: part.chapter && headingText(part.chapter),
  subs: headings.filter((h) => h.level === part.head.level + 1).map((h) => h.title),
  top,
});

// 目次の木。章（第4章は将来像を子に持つ）を並べ、いまのページは中の見出しを段の深さのまま入れ子にする
interface Node { label: string; href?: string; current?: boolean; level: number; children: Node[] }
const own = (p: HonbunPart): Node => ({
  label: p.slug ? headingText(p.head) : p.head.title,
  href: p.href,
  current: p === part,
  level: p.head.level,
  children: p === part ? nest(headings) : [],
});
function nest(hs: HonbunHeading[]): Node[] {
  const root: Node = { label: '', level: 0, children: [] };
  const stack = [root];
  for (const h of hs) {
    while (stack.length > 1 && stack[stack.length - 1].level >= h.level) stack.pop();
    const n: Node = { label: headingText(h), href: `#${honbunAnchor(h.id)}`, level: h.level, children: [] };
    stack[stack.length - 1].children.push(n);
    stack.push(n);
  }
  return root.children;
}
const tree: Node[] = [];
for (const p of parts) {
  if (!p.chapter) tree.push(own(p));
  else if (tree.at(-1)?.label === headingText(p.chapter)) tree.at(-1)?.children.push(own(p));
  else tree.push({ label: headingText(p.chapter), href: p.href, level: 1, children: [own(p)] });
}

// PDF のページへのリンク。ページが変わったかたまりの頭に、印字のページを出す
const src = planSourceLink('kihon', part.head.source);
const pageHref = (page: number) => planSourceLink('kihon', part.head.source, page)?.href ?? '#';
const pageMarks = new Set<KihonHonbunRow>();
let lastPage = part.head.page;
for (const b of inner) {
  if (b.page !== lastPage) pageMarks.add(b);
  lastPage = b.page;
}
const lastBlock = [part.head, ...inner].reduce((a, b) => (b.page > a.page ? b : a));
const printedOf = (b: { page: number; printed?: number }) => (b.printed ? `${b.printed}ページ` : `PDFの${b.page}ページ`);
const figs = inner.filter((b) => b.kind === 'fig');
// 箇条（「① …」「1) …」）の段落は、2行目以降を印の後ろにそろえる（県の PDF と同じぶら下げ）
const LIST_ITEM = /^([①-⑳]|\d+\))/;
// 沖縄県PDCA のページ（基本施策・施策）。施策展開のページは無いので付けない
const pdcaLink = (h: HonbunHeading) =>
  h.pdca && h.level === 3 ? { href: `/kihon/${h.pdca}/`, label: 'この基本施策の進み具合' }
  : h.pdca && h.level === 5 ? { href: `/shisaku/${h.pdca}/`, label: 'この施策の進み具合' }
  : null;
---
<Base title={meta.title} description={meta.description} ogType="article">
  <div class="hb">
    {/* スマホの幅で上に貼り付く行（スクリプトが動くときだけ出す）。いま読んでいる見出しの名前は scripts/honbun.ts が入れる */}
    <div class="hb-bar">
      <button type="button" class="hb-open" aria-expanded="false" aria-controls="hb-nav">目次</button>
      <span class="hb-now" aria-hidden="true">{top ? KIHON_KEIKAKU.name : headingText(part.head)}</span>
    </div>
    <nav class="hb-nav" id="hb-nav" aria-label="基本計画の目次">
      <div class="hb-nav-top">
        <a class="hb-plan" href={KIHON_KEIKAKU.href} aria-current={top ? 'page' : undefined}>{KIHON_KEIKAKU.name}</a>
        <button type="button" class="hb-close">閉じる</button>
      </div>
      <ol class="hb-tree">
        {tree.map(function item(n: Node) {
          return (
            <li class:list={[`lv${n.level}`, n.current && 'here']}>
              {n.href ? <a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a> : <span>{n.label}</span>}
              {n.children.length > 0 && <ol>{n.children.map(item)}</ol>}
            </li>
          );
        })}
      </ol>
    </nav>

    <article class="hb-body">
      <header class="hb-head">
        <p class="hb-kicker small secondary">{top ? `沖縄県・${KIHON_KEIKAKU.published}策定（${KIHON_KEIKAKU.period}）` : part.chapter ? `${KIHON_KEIKAKU.name} ${headingText(part.chapter)}` : KIHON_KEIKAKU.name}</p>
        <h1 id={top ? undefined : honbunAnchor(part.head.id)}>{top ? `${KIHON_KEIKAKU.name}の本文` : headingText(part.head)}</h1>
        {top ? (
          <p class="lead">
            沖縄県が{KIHON_KEIKAKU.published}に策定した、{KIHON_KEIKAKU.period}の沖縄振興の計画です。沖縄県PDCAの施策と主な取組は、この計画の基本施策（第4章）を実施計画で具体化したものです。
            ここでは、県の PDF の本文を、章ごと（第4章は将来像ごと）に目次からたどって読めます。基本施策と施策の見出しからは、このサイトのその進み具合のページへ移れます。
          </p>
        ) : (
          <p class="small secondary hb-src">
            {src && <ExtLink href={pageHref(part.head.page)}>{src.label}</ExtLink>}（{lastBlock !== part.head && part.head.printed && lastBlock.printed ? `${part.head.printed}〜${lastBlock.printed}ページ` : printedOf(part.head)}）
          </p>
        )}
      </header>

      {top && <h2 id={honbunAnchor(part.head.id)} class="hb-h">{part.head.title}</h2>}
      {inner.map((b) => (
        <>
          {pageMarks.has(b) && <ExtLink class="hb-pg" href={pageHref(b.page)} title={`PDF の ${b.page}ページ目`}>{printedOf(b)}</ExtLink>}
          {b.kind === 'h' ? (() => {
            const Tag = headingTag(part, b.level);
            const link = pdcaLink(b);
            return (
              <>
                <Tag id={honbunAnchor(b.id)} class:list={['hb-h', `lv${b.level}`]}><a class="hb-hlink" href={`#${honbunAnchor(b.id)}`}>{b.mark && <span class="hb-mark">{b.level === 1 ? `第${b.mark}章` : b.mark}</span>}{b.title}</a></Tag>
                {link && <p class="hb-pdca small"><a href={link.href}>{link.label}（沖縄県PDCA）</a></p>}
              </>
            );
          })()
          : b.kind === 'label' ? <p class="hb-label">{b.text}</p>
          : b.kind === 'fig' ? <p class="hb-fig small">図は省いています（<ExtLink href={pageHref(b.page)}>PDF の{printedOf(b)}</ExtLink>）</p>
          : <p class:list={['hb-p', LIST_ITEM.test(b.text) && 'item']}>{splitNotes(b.text).map((s) => (s.note ? <span class="hb-note" title="県の資料編に用語の説明があります">*</span> : s.text))}</p>}
        </>
      ))}

      <nav class="hb-pager" aria-label="前後の章">
        {prev ? <a class="hb-prev" href={prev.href}><small>前へ</small><span>{prev.slug ? headingText(prev.head) : prev.head.title}</span></a> : <span></span>}
        {next && <a class="hb-next" href={next.href}><small>次へ</small><span>{headingText(next.head)}</span></a>}
      </nav>

      <section class="hb-about small" aria-labelledby="source">
        <h2 id="source" class="hb-about-h">出典と読み方</h2>
        <p>
          {src && <><ExtLink href={src.href}>{src.label}</ExtLink>（沖縄県、{KIHON_KEIKAKU.published}）の PDF の文字を読み取ったものです（PDF の{part.head.page}〜{lastBlock.page}ページ）。</>}
          段落の中の改行は画面の幅に合わせ、ページの区切りは段落の頭に印字のページで示しています。ふりがなは省いています{figs.length > 0 && '。図は PDF で見てください'}。
          「*」の付いた言葉は、県の資料編に用語の説明があります。
        </p>
        <p>計画の本文の著作権は沖縄県にあります。引用するときは、PDF で確かめてください。</p>
      </section>
    </article>
  </div>
</Base>

<style>
  /* 左に目次、右に本文。目次は画面の高さに収め、目次の中だけを動かす */
  .hb { display: grid; grid-template-columns: 270px minmax(0, 1fr); gap: 0 40px; align-items: start; margin-top: 24px; }
  .hb-bar { display: none; }
  .hb-nav {
    position: sticky; top: 0; max-height: 100vh; overflow-y: auto; overscroll-behavior: contain;
    padding: 16px 8px 24px 0; font-size: 0.875rem; line-height: 1.55;
  }
  .hb-nav-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .hb-plan { font-family: var(--font-display); font-weight: 700; color: var(--ink); text-decoration: none; font-size: 0.9375rem; }
  .hb-plan[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 2px; }
  .hb-close { display: none; }
  .hb-tree, .hb-tree ol { list-style: none; margin: 0; padding: 0; }
  .hb-tree ol { padding-left: 12px; border-left: 1.5px solid var(--hair); margin: 2px 0 4px 6px; }
  .hb-tree li { margin: 0; }
  .hb-tree a, .hb-tree span { display: block; padding: 3px 8px; border-radius: 8px; color: var(--ink); text-decoration: none; }
  .hb-tree a:hover { background: var(--sky); }
  .hb-tree > li > a, .hb-tree > li > span { font-family: var(--font-display); font-weight: 700; }
  .hb-tree li.here > a { background: var(--paper); border: 2px solid var(--line); box-shadow: 2px 2px 0 var(--shadow); padding: 2px 7px; }
  .hb-tree .lv5 > a { color: var(--ink-2); font-size: 0.8125rem; }
  /* いま読んでいる見出し（scripts/honbun.ts） */
  .hb-tree a[aria-current="location"] { background: var(--sky); font-weight: 700; color: var(--ink); }

  .hb-body { min-width: 0; max-width: 46em; }
  .hb-head { margin-bottom: 8px; }
  .hb-head h1 { margin: 0.1em 0 0.3em; }
  .hb-kicker { margin: 0; }
  .hb-src { margin: 0; }
  .hb-h { scroll-margin-top: 16px; }
  .hb-hlink { color: inherit; text-decoration: none; }
  .hb-hlink:hover { text-decoration: underline; text-decoration-color: var(--hair); }
  .hb-mark { margin-right: 0.5em; }
  h2.hb-h { margin-top: 2em; }
  h3.hb-h { margin-top: 1.8em; }
  h4.hb-h, h5.hb-h, h6.hb-h { font-family: var(--font-display); font-size: 1rem; margin: 1.6em 0 0.3em; line-height: 1.5; }
  .hb-pdca { margin: -0.2em 0 0.6em; }
  .hb-pdca a::after { content: " →"; }
  /* 本文は段落の頭を1字下げる（県の PDF と同じ）。行を少し広げて読みやすくする */
  .hb-p { text-indent: 1em; line-height: 1.95; margin: 0.5em 0; }
  .hb-p.item { text-indent: -1em; padding-left: 1em; }
  .hb-label { font-family: var(--font-display); font-weight: 700; margin: 1.2em 0 0.3em; }
  .hb-note { font-size: 0.75em; vertical-align: super; line-height: 0; color: var(--ink-2); }
  .hb-fig { border: 2px dashed var(--hair); border-radius: 12px; padding: 10px 14px; color: var(--ink-2); }
  /* 印字のページ。段落の右上に小さく寄せる */
  .hb-body :global(a.hb-pg) { float: right; clear: right; margin: 0.35em 0 0.2em 12px; font-size: 0.75rem; line-height: 1.4; color: var(--muted); text-decoration-color: var(--hair); }

  .hb-pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 40px 0 0; clear: both; }
  .hb-pager a { display: grid; gap: 2px; padding: 10px 14px; border: 2px solid var(--line); border-radius: 14px; background: var(--paper); box-shadow: 3px 3px 0 var(--shadow); color: var(--ink); text-decoration: none; font-family: var(--font-display); font-weight: 700; line-height: 1.45; }
  .hb-pager a small { color: var(--ink-2); font-weight: 400; }
  .hb-pager a:hover { background: var(--sky); }
  .hb-next { text-align: right; grid-column: 2; }
  .hb-about { margin-top: 32px; color: var(--ink-2); }
  .hb-about-h { font-size: 1rem; margin: 0 0 0.3em; }

  /* スマホ・タブレットの幅: 目次は本文の上。スクリプトが動くときは、貼り付いた「目次」のボタンから全面に開く */
  @media (max-width: 900px) {
    .hb { grid-template-columns: minmax(0, 1fr); margin-top: 8px; }
    .hb-nav { position: static; max-height: none; padding: 0; margin-bottom: 16px; }
    :global(:root.js) .hb-bar {
      display: flex; align-items: center; gap: 10px; position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
      margin: 0 -16px; padding: 8px 16px; background: var(--bg); border-bottom: 2px solid var(--hair);
    }
    .hb-open {
      flex: none; font: inherit; font-family: var(--font-display); font-size: 0.9375rem; font-weight: 700; color: var(--ink); cursor: pointer;
      padding: 4px 14px; min-height: 38px; border: 2px solid var(--line); border-radius: 999px; background: var(--paper);
    }
    .hb-now { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; font-size: 0.9375rem; }
    :global(:root.js) .hb-nav:not(.open) { display: none; }
    :global(:root.js) .hb-nav.open {
      position: fixed; inset: 0; z-index: 60; max-height: none; overflow-y: auto; margin: 0;
      padding: calc(12px + env(safe-area-inset-top, 0px)) 16px 32px; background: var(--paper); font-size: 0.9375rem;
    }
    :global(:root.js) .hb-nav.open .hb-close {
      display: inline-flex; flex: none; font: inherit; font-family: var(--font-display); font-weight: 700; color: var(--ink); cursor: pointer;
      padding: 4px 14px; min-height: 38px; border: 2px solid var(--line); border-radius: 999px; background: var(--paper);
    }
    .hb-h { scroll-margin-top: 64px; }
  }
  @media print {
    .hb { display: block; }
    .hb-nav, .hb-bar, .hb-pager { display: none !important; }
  }
</style>
